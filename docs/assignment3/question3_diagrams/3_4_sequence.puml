@startuml
!pragma layout smetana
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 16
skinparam defaultFontColor #17334A
skinparam ArrowColor #42647A
skinparam ArrowFontSize 13
skinparam roundcorner 8
skinparam nodesep 35
skinparam ranksep 45
skinparam classAttributeIconSize 0
skinparam classBackgroundColor #F0F7FA
skinparam classBorderColor #42647A
skinparam componentBackgroundColor #F0F7FA
skinparam componentBorderColor #42647A
skinparam rectangleBorderColor #42647A
skinparam usecaseBackgroundColor #F0F7FA
skinparam usecaseBorderColor #42647A
skinparam noteBackgroundColor #FFF6DE
skinparam noteBorderColor #BCA76D
skinparam noteFontSize 14
skinparam packageStyle rectangle
skinparam sequenceMessageAlign center
skinparam sequenceParticipantPadding 15
skinparam maxMessageSize 165
skinparam ArrowFontSize 16
hide footbox
skinparam sequenceGroupBodyBackgroundColor #FFFFFF
skinparam sequenceGroupBackgroundColor #E5F0F4
actor "Patient" as Patient
boundary "Browser\nstroke.html" as Browser
control "stroke_predict\nhealth_ai.views" as View
control "predict_stroke\nml.prediction" as Predictor
participant "_load_model /\n_predict_with_pipeline\nML adapter" as ML
control "_save_prediction\nhealth_ai.services" as Save
database "PredictionRecord\napplication database" as DB
autonumber
Patient -> Browser : Submit health indicators
Browser -> View : POST /predict/stroke/
break No authenticated session
 View --> Browser : 302 redirect to login
end
View -> View : StrokePredictionForm(request.POST)\nis_valid()
break Invalid form
 View --> Browser : 200 form with validation errors
end
View -> View : Read form.cleaned_data
View -> Predictor : predict_stroke(data)
Predictor -> ML : _load_model("stroke_model.pkl")
ML -> ML : Check artifact path;\njoblib.load if present
break Artifact exists but deserialisation fails
 ML --> View : Unhandled exception; request fails (500)
end
ML --> Predictor : model or None
alt Model is present
 Predictor -> ML : _predict_with_pipeline(model, data)
 ML -> ML : DataFrame([data]); predict_proba(row)[0][1]
 ML --> Predictor : Probability, or None on inference exception
end
opt No model / no usable inference result
 Predictor -> Predictor : Calculate heuristic fallback score
end
Predictor -> Predictor : risk_label(probability)
Predictor --> View : probability, risk
View -> View : recommend_diet("stroke", risk); set advice
View -> Save : user, disease, risk, probability, data, advice
Save -> DB : PredictionRecord.objects.create(...)
alt Persistence succeeds
 DB --> Save : Saved record
 Save --> View : record
else OperationalError / ProgrammingError
 DB --> Save : Database exception
 Save --> View : None
 View -> View : Add report-not-saved warning
end
View --> Browser : 200 rendered result, foods and advice
Browser --> Patient : Display result; saved history only if persistence succeeded
note over Predictor,ML
Emerging-technology path: trained scikit-learn pipeline if available.
Inspected workspace has no artifacts: heuristic fallback is the available path.
end note
@enduml
